server = false
data_dir = "/opt/consul"
datacenter= "dc1"

bind_addr = "{{ consul_client_ip }}"
advertise_addr = "{{ consul_client_ip }}"
client_addr = "127.0.0.1"

retry_join = ["192.168.56.11"]  
retry_interval = "30s"
retry_max = 0  

rejoin_after_leave = true

connect {
  enabled = true
}
ports {
    grpc = 8502
}